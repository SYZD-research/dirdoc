{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dirdoc:schema:pfd:v1",
  "title": "dirdoc Program File Document (.dirdoc/<file>.dirdoc_pfd), schema version 1",
  "description": "Stored as UTF-8 JSON, zstd-compressed by default. dirdoc keeps fields it does not know; keys starting with x- are user extensions.",
  "type": "object",
  "required": ["format", "version", "target", "overview"],
  "properties": {
    "format": { "const": "dirdoc/pfd" },
    "version": { "const": 1 },
    "target": { "type": "string", "minLength": 1, "description": "Name of the documented file, a sibling of the .dirdoc directory." },
    "target_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Hash of the documented file when it was last compiled or touched, with line endings converted to LF. Missing in documents written before Phase 2."
    },
    "summary": { "type": "string" },
    "overview": {
      "type": "object",
      "description": "Table of contents generated by compile from the entries and, for source files of the languages dirdoc analyzes, from code analysis.",
      "required": ["types", "functions", "variables"],
      "properties": {
        "types": { "$ref": "#/$defs/overviewItems" },
        "functions": { "$ref": "#/$defs/overviewItems" },
        "variables": { "$ref": "#/$defs/overviewItems" },
        "undocumented": {
          "type": "array",
          "description": "Top-level symbols of the file that no entry documents, in line order. Absent when the file was not analyzed.",
          "items": {
            "type": "object",
            "required": ["id", "kind", "line", "signature"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "kind": { "enum": ["type", "function", "variable"] },
              "line": { "type": "integer", "minimum": 1 },
              "signature": { "type": "string" }
            }
          }
        }
      }
    },
    "types": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "functions": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "variables": {
      "type": "array",
      "items": { "allOf": [{ "$ref": "#/$defs/entry" }, { "not": { "required": ["document"] } }] }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[\\p{L}\\p{Nd}_.:$-]{1,128}$" },
    "entry": {
      "type": "object",
      "required": ["id", "name", "summary"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "document": { "type": "string", "description": "Markdown." }
      }
    },
    "overviewItems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "summary"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string" },
          "summary": { "type": "string" },
          "line": { "type": "integer", "minimum": 1, "description": "Line of the symbol the entry documents, from code analysis." },
          "signature": { "type": "string", "description": "Declaration of that symbol on one line." }
        }
      }
    }
  }
}
