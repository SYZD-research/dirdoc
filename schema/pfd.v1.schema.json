{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dirdoc:schema:pfd:v1",
  "title": "dirdoc Program File Document (.dirdoc/<file>.dirdoc_pfd), schema version 1",
  "description": "Stored as UTF-8 JSON, zstd-compressed by default. dirdoc keeps fields it does not know; keys starting with x- are user extensions.",
  "type": "object",
  "required": ["format", "version", "target", "overview"],
  "properties": {
    "format": { "const": "dirdoc/pfd" },
    "version": { "const": 1 },
    "target": { "type": "string", "minLength": 1, "description": "Name of the documented file, a sibling of the .dirdoc directory." },
    "target_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Hash of the documented file at compile time, with line endings converted to LF. Written from Phase 2 on."
    },
    "summary": { "type": "string" },
    "overview": {
      "type": "object",
      "description": "Table of contents generated by compile from the entries.",
      "required": ["types", "functions", "variables"],
      "properties": {
        "types": { "$ref": "#/$defs/overviewItems" },
        "functions": { "$ref": "#/$defs/overviewItems" },
        "variables": { "$ref": "#/$defs/overviewItems" }
      }
    },
    "types": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "functions": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "variables": {
      "type": "array",
      "items": { "allOf": [{ "$ref": "#/$defs/entry" }, { "not": { "required": ["document"] } }] }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[\\p{L}\\p{Nd}_.:$-]{1,128}$" },
    "entry": {
      "type": "object",
      "required": ["id", "name", "summary"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "document": { "type": "string", "description": "Markdown." }
      }
    },
    "overviewItems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "summary"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    }
  }
}
